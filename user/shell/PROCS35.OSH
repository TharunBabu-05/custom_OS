# Run with source -e /boot/PROCS35.OSH
mkdir /tmp/procs35
/boot/STREAM.ELF generate | cat | cat | cat | cat | cat | /boot/HASH.ELF > /tmp/procs35/hash
sha256 /tmp/procs35/hash 56787e142c356f0af5142cc2e695559f923cfa4afe2b1f306d78a1e7fbab7da3
cat /tmp/procs35/hash
ps -l | cat | cat | cat | cat | cat | cat
bg 30 /boot/SPIN.ELF
bg 30 /boot/SPIN.ELF
bg 30 /boot/SPIN.ELF
run /boot/ECHO.ELF foreground-with-three-jobs
bg 30 /boot/SPIN.ELF
jobs
stopall
jobs
bg 30 /boot/SLEEP.ELF 80
bg 30 /boot/SLEEP.ELF 100
bg 30 /boot/SLEEP.ELF 120
bg 30 /boot/SLEEP.ELF 140
waitall
jobs
rm /tmp/procs35/hash
rmdir /tmp/procs35
echo "PASS: seven-stage binary pipeline, process inventory and four-job control."
